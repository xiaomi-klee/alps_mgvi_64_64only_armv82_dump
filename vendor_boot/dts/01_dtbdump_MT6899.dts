/dts-v1/;

/ {
	model = "MT6899";
	compatible = "mediatek,MT6899";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		i2c0 = "/soc/i2c@11d00000";
		i2c1 = "/soc/i2c@11d01000";
		i2c2 = "/soc/i2c@11b70000";
		i2c3 = "/soc/i2c@11f00000";
		i2c4 = "/soc/i2c@11cb0000";
		i2c5 = "/soc/i2c@11f01000";
		i2c6 = "/soc/i2c@11e00000";
		i2c7 = "/soc/i2c@11d02000";
		i2c8 = "/soc/i2c@11cb1000";
		i2c9 = "/soc/i2c@11d10000";
		i2c10 = "/soc/i2c@11280000";
		i2c11 = "/soc/i2c@11281000";
		i2c12 = "/soc/i2c@11282000";
		i2c13 = "/soc/i2c@11283000";
		ovl3 = "/soc/disp-ovl0-2l@14402000";
		ovl4 = "/soc/disp-ovl1-2l@14403000";
		ovl5 = "/soc/disp-ovl2-2l@14404000";
		ovl6 = "/soc/disp-ovl3-2l@14405000";
		mdp-rsz0 = "/soc/disp-mdp-rsz0@14407000";
		wdma1 = "/soc/disp1-wdma0@1420e000";
		wdma10 = "/soc/disp-wdma0@14408000";
		wdma11 = "/soc/disp-wdma2@1440a000";
		wdma14 = "/soc/disp-ufbc-wdma0@14409000";
		tdshp0 = "/soc/disp-tdshp0@1401c000";
		tdshp1 = "/soc/disp-tdshp1@1401d000";
		color0 = "/soc/disp-color0@1400c000";
		color1 = "/soc/disp-color1@1400d000";
		ccorr0 = "/soc/disp-ccorr0@14006000";
		ccorr1 = "/soc/disp-ccorr1@14007000";
		ccorr2 = "/soc/disp-ccorr2@14008000";
		ccorr3 = "/soc/disp-ccorr3@14009000";
		c3d0 = "/soc/disp-c3d0@14004000";
		c3d1 = "/soc/disp-c3d1@14005000";
		aal0 = "/soc/disp-aal0@14002000";
		aal1 = "/soc/disp-aal1@14003000";
		maal0 = "/soc/disp-mdp-aal0@14013000";
		maal1 = "/soc/disp-mdp-aal1@1401f000";
		gamma0 = "/soc/disp-gamma0@14011000";
		gamma1 = "/soc/disp-gamma1@14012000";
		dither0 = "/soc/disp-dither0@1400e000";
		dither1 = "/soc/disp-dither1@1400f000";
		dither2 = "/soc/disp-dither2@14010000";
		chist0 = "/soc/disp-chist0@1400a000";
		chist1 = "/soc/disp-chist1@1400b000";
		rsz0 = "/soc/disp-rsz0@14019000";
		rsz1 = "/soc/disp-rsz1@1401a000";
		rsz4 = "/soc/ovl-rsz0@14406000";
		postmask0 = "/soc/disp-postmask0@14017000";
		postmask1 = "/soc/disp-postmask1@14018000";
		spr0 = "/soc/disp-spr@1401b000";
		postalign0 = "/soc/disp-postalign0@14024000";
		dsc0 = "/soc/disp1-dsc-wrap0@14206000";
		dsc1 = "/soc/disp1-dsc-wrap1@14207000";
		dsc2 = "/soc/disp1-dsc-wrap2@14208000";
		splitter0 = "/soc/disp1-splitter0@14203000";
		splitter1 = "/soc/disp1-splitter1@14204000";
		oddmr0 = "/soc/disp-oddmr0@14015000";
		dsi0 = "/soc/dsi0@1420a000";
		mutex0 = "/soc/disp1-mutex0@14201000";
		mtksmmu0 = "/soc/iommu@1e816000";
		mtksmmu1 = "/soc/iommu@1e81b000";
		mtksmmu2 = "/soc/iommu@19010000";
		mtksmmu3 = "/soc/iommu@19015000";
		mml-wrot0 = "/soc/mml1-wrot0@1f80f000";
		mml-wrot1 = "/soc/mml1-wrot2@1f815000";
		mml-wrot2 = "/soc/mml0-wrot0@1f00f000";
		inlinerotate0 = "/soc/inlinerot@1440b000";
		dlo-async8 = "/soc/ovl-dlo-async0@14400000";
		dli-async12 = "/soc/ovl-dli-async0@14400000";
		y2r0 = "/soc/disp-y2r0@14023000";
		y2r4 = "/soc/ovl-y2r0@14412000";
		mmlsys-cfg = "/soc/mmlsys-config@1f800000";
		mml-mutex = "/soc/mml1-mutex0@1f801000";
	};

	clkbuf-ctrl {
		pmic-supply = <0x02>;
		compatible = "mediatek,mt6899-clkbuf";
		pmic = <0x02>;
		srclken-rc = <0x03>;
		pmif = <0x04 0x00 0x02>;
		phandle = <0x1c3>;
	};

	chosen {
		bootargs = "console=tty0 root=/dev/ram \t\t\t    nosoftlockup \t\t\t    8250.nr_uarts=4 \t\t\t    restrict_cma_redirect \t\t\t    androidboot.hardware=mt6899 \t\t\t    vmalloc=400M swiotlb=noforce \t\t\t    firmware_class.path=/vendor/firmware,/odm/firmware \t\t\t    cgroup.memory=nosocket,nokmem \t\t\t    disable_dma32=on \t\t\t    rcu_nocbs=all \t\t\t    transparent_hugepage=never";
		mkp_panic = "on";
		kaslr-seed = <0x00 0x00>;
		phandle = <0xbd>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			performance-domains = <0x05 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x11>;
		};

		cpu@1 {
			device_type = "cpu";
			reg = <0x100>;
			performance-domains = <0x05 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x12>;
		};

		cpu@2 {
			device_type = "cpu";
			reg = <0x200>;
			performance-domains = <0x05 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x13>;
		};

		cpu@3 {
			device_type = "cpu";
			reg = <0x300>;
			performance-domains = <0x05 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x14>;
		};

		cpu@100 {
			device_type = "cpu";
			reg = <0x400>;
			performance-domains = <0x05 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0b 0x0c 0x0d 0x09 0x0a>;
			capacity-dmips-mhz = <0x3bb>;
			phandle = <0x15>;
		};

		cpu@101 {
			device_type = "cpu";
			reg = <0x500>;
			performance-domains = <0x05 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0b 0x0c 0x0d 0x09 0x0a>;
			capacity-dmips-mhz = <0x3bb>;
			phandle = <0x16>;
		};

		cpu@102 {
			device_type = "cpu";
			reg = <0x600>;
			performance-domains = <0x05 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0b 0x0c 0x0d 0x09 0x0a>;
			capacity-dmips-mhz = <0x3bb>;
			phandle = <0x17>;
		};

		cpu@200 {
			device_type = "cpu";
			reg = <0x700>;
			performance-domains = <0x05 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0e 0x0f 0x10 0x09 0x0a>;
			capacity-dmips-mhz = <0x3cb>;
			phandle = <0x18>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x11>;
				};

				core1 {
					cpu = <0x12>;
				};

				core2 {
					cpu = <0x13>;
				};

				core3 {
					cpu = <0x14>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x15>;
				};

				core1 {
					cpu = <0x16>;
				};

				core2 {
					cpu = <0x17>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x18>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x61>;
				exit-latency-us = <0xfc>;
				min-residency-us = <0x1a36>;
				phandle = <0x06>;
			};

			cpuoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x35>;
				exit-latency-us = <0x8f>;
				min-residency-us = <0x848>;
				phandle = <0x0b>;
			};

			cpuoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x28>;
				exit-latency-us = <0x6b>;
				min-residency-us = <0xa14>;
				phandle = <0x0e>;
			};

			clusteroff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x6d>;
				exit-latency-us = <0x145>;
				min-residency-us = <0x1a36>;
				phandle = <0x07>;
			};

			clusteroff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x3b>;
				exit-latency-us = <0xbc>;
				min-residency-us = <0x848>;
				phandle = <0x0c>;
			};

			clusteroff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x2b>;
				exit-latency-us = <0x8a>;
				min-residency-us = <0xa14>;
				phandle = <0x0f>;
			};

			mcusysoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x54d>;
				exit-latency-us = <0x343>;
				min-residency-us = <0x1a36>;
				phandle = <0x08>;
			};

			mcusysoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x4b2>;
				exit-latency-us = <0x2a7>;
				min-residency-us = <0x848>;
				phandle = <0x0d>;
			};

			mcusysoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x477>;
				exit-latency-us = <0x263>;
				min-residency-us = <0xa14>;
				phandle = <0x10>;
			};

			system-vcore {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20100ff>;
				local-timer-stop;
				entry-latency-us = <0x3ac>;
				exit-latency-us = <0xdac>;
				min-residency-us = <0x8980>;
				phandle = <0x09>;
			};

			s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20180ff>;
				local-timer-stop;
				entry-latency-us = <0x2710>;
				exit-latency-us = <0x2710>;
				min-residency-us = <0xffffffff>;
				phandle = <0x0a>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	fdvfs@c068200 {
		compatible = "mediatek,fdvfs";
		reg = <0x00 0xc068200 0x00 0x20 0x00 0xc068220 0x00 0x04 0x00 0xc0de474 0x00 0x04>;
		phandle = <0x1c4>;
	};

	mcupm@c070000 {
		compatible = "mediatek,mcupm";
		mbox-extend = <0x10>;
		reg = <0x00 0xc070000 0x00 0x50000 0x00 0xc0df600 0x00 0xa0 0x00 0xc072004 0x00 0x04 0x00 0xc072018 0x00 0x04 0x00 0xc072000 0x00 0x04 0x00 0xc072010 0x00 0x04>;
		reg-names = "mcupm_base\0mbox0_base\0mbox0_set\0mbox0_clr\0mbox0_send\0mbox0_recv";
		interrupts = <0x00 0x30 0x04 0x00 0x00 0x31 0x04 0x00 0x00 0x32 0x04 0x00 0x00 0x33 0x04 0x00 0x00 0x34 0x04 0x00 0x00 0x35 0x04 0x00 0x00 0x36 0x04 0x00 0x00 0x37 0x04 0x00 0x00 0x38 0x04 0x00 0x00 0x39 0x04 0x00 0x00 0x3a 0x04 0x00 0x00 0x3b 0x04 0x00 0x00 0x3c 0x04 0x00 0x00 0x3d 0x04 0x00 0x00 0x3e 0x04 0x00 0x00 0x3f 0x04 0x00>;
		interrupt-names = "mbox0\0mbox1\0mbox2\0mbox3\0mbox4\0mbox5\0mbox6\0mbox7\0mbox8\0mbox9\0mbox10\0mbox11\0mbox12\0mbox13\0mbox14\0mbox15";
		phandle = <0x134>;
	};

	interrupt-controller@c400000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#redistributor-regions = <0x01>;
		interrupt-parent = <0x01>;
		interrupt-controller;
		reg = <0x00 0xc400000 0x00 0x40000 0x00 0xc440000 0x00 0x200000>;
		interrupts = <0x01 0x09 0x04 0x00>;
		phandle = <0x01>;

		ppi-partitions {

			interrupt-partition-0 {
				affinity = <0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18>;
				phandle = <0x19>;
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x0d 0x04 0x00 0x01 0x0e 0x04 0x00 0x01 0x0b 0x04 0x00 0x01 0x0a 0x04 0x00>;
		clock-frequency = <0xc65d40>;
		phandle = <0x1c5>;
	};

	hwrng {
		compatible = "arm,sec-rng";
		methods = "smc";
		method-fid = [02 6a];
		quality = [03 84];
		phandle = <0x1c6>;
	};

	security-ao@1040d000 {
		compatible = "mediatek,security_ao";
		reg = <0x00 0x1040d000 0x00 0x1000>;
		phandle = <0x1c7>;
	};

	masp@1040e000 {
		compatible = "mediatek,masp";
		reg = <0x00 0x1040e000 0x00 0x1000>;
		interrupts = <0x00 0x30c 0x04 0x00>;
		phandle = <0x1c8>;
	};

	pmu-chaberton {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x19>;
		phandle = <0x1c9>;
	};

	dsu-pmu-0 {
		compatible = "arm,dsu-pmu";
		interrupts = <0x00 0x23 0x04 0x00>;
		cpus = <0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18>;
		phandle = <0x1ca>;
	};

	connscp {
		compatible = "mediatek,mt6899-conn_scp";
		scp-shm-size = <0x20000>;
		scp-remap-offset = <0x2100000>;
		scp-remap-size = <0x20000>;
		scp-remap-addr = <0x00>;
		ipi-mbox-size = <0x40>;
		phandle = <0x1cb>;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x40000000>;
		phandle = <0x1cc>;
	};

	rt-pd-manager {
		compatible = "mediatek,rt-pd-manager";
		nr-port = <0x01>;
		en-wd0-port0;
	};

	pd_cp_manager {
		phandle = <0x1cd>;
	};

	pd-adapter {
		compatible = "mediatek,pd_adapter";
		nr-port = <0x01>;
		force-cv;
		adapter-name = "pd_adapter";
		phandle = <0x1ce>;
	};

	flashlight-core {
		compatible = "mediatek,flashlight_core";
		low-battery-level = <0x02>;
		battery-percent-level = <0x01>;
		battery-oc-level = <0x02>;
		phandle = <0x1cf>;
	};

	mtk-composite-v4l2-1 {
		compatible = "mediatek,mtk_composite_v4l2_1";
		phandle = <0x1d0>;
	};

	mtk-composite-v4l2-2 {
		compatible = "mediatek,mtk_composite_v4l2_2";
		phandle = <0x1d1>;
	};

	mtk-ctd {
		compatible = "mediatek,mtk_ctd";
		nr-port = <0x01>;
		chg-name-port0 = "primary_chg";
		bc12-sel-port0 = <0x00>;
		bc12-psy-port0 = <0x1a>;
		phandle = <0x1d2>;
	};

	subpmic-pmu-eint {
		phandle = <0x1d3>;
	};

	odm {
		compatible = "simple-bus";
		phandle = <0x1d4>;
	};

	mbraink-plat {
		compatible = "mediatek,mbraink-v6899";
		gauge = <0x1b>;
		ufsnotify = <0x1c>;
		phandle = <0x1d5>;
	};

	met {

		met-emi {
			compatible = "mediatek,met_emi";
			emi-num = <0x02>;
			dram-num = <0x02>;
			dramc-ver = <0x02>;
			slc-ver = <0x03>;
			met-emi-support-list = <0xf3>;
			cen-emi-reg-base = <0x10219000 0x1021d000>;
			cen-emi-reg-size = <0x1000>;
			chn-emi-reg-base = <0x10235000 0x10245000 0x10255000 0x10265000>;
			chn-emi-reg-size = <0xa90>;
			dramc-nao-reg-base = <0x10234000 0x10244000 0x10254000 0x10264000>;
			dramc-nao-reg-size = <0xf08>;
			dramc-ao-reg-base = <0x10230000 0x10240000 0x10250000 0x10260000>;
			dramc-ao-reg-size = <0x2000>;
			dramc-ao-bus-mon1 = <0x118>;
			ddrphy-ao-reg-base = <0x10238000 0x10248000 0x10258000 0x10268000>;
			ddrphy-ao-reg-size = <0x1650>;
			ddrphy-ao-misc-cg-ctrl0 = <0x00>;
			ddrphy-ao-misc-cg-ctrl2 = <0xad4>;
			dram-freq-default = <0x1900>;
			ddr-ratio-default = <0x08>;
			dram-type-default = <0x08>;
			apmixedsys-reg-base = <0x1000c000>;
			apmixedsys-reg-size = <0x410>;
			slc-pmu-reg-base = <0x10342000 0x10343000>;
			slc-pmu-reg-size = <0x1000>;
			slc-pmu-2nd-reg-base = <0x10359000 0x1035c000>;
			slc-pmu-2nd-reg-size = <0x1000>;
			phandle = <0x1d6>;
		};

		met-res-ram {
			compatible = "mediatek,met_res_ram";

			met-res-ram-sspm {
				size = <0x400000>;
				start = <0x00>;
			};

			met-res-ram-mcupm {
				size = <0x400000>;
				start = <0x00>;
			};

			met-res-ram-gpueb {
				size = <0x400000>;
				start = <0x00>;
			};
		};

		met-config {
			compatible = "mediatek,met_config";
			met-config-list = <0x01>;
		};

		mcupm-rts-header {
			node-0 = "MCUPM_MET_UNIT_TEST\0test";
			node-1 = "__MCUPM_MET_L3CTL__\0op_policy,ct_portion,nct_portion,cpuqos_mode,dnth0,dnth1,upth0,upth1,hit0,hit1,hit2,hit3,mis0,mis1,mis2,mis3,l3_hit,l3_mis,pmu_cyc_cnt";
			node-2 = "__MCUPM_MET_TEST__\0taskId,isrId,dvfs";
			node-3 = "MCUPM_DSU_DVFS_ACTIVE\0cpu0,cpu1,cpu2,cpu3,cpu4,cpu5,cpu6,cpu7";
			node-4 = "MCUPM_DSU_DVFS_L3_STALL\0cpu0,cpu1,cpu2,cpu3,cpu4,cpu5,cpu6,cpu7";
			node-5 = "MCUPM_DSU_DVFS_EMI_STALL\0cpu0,cpu1,cpu2,cpu3,cpu4,cpu5,cpu6,cpu7";
			node-6 = "MCUPM_DSU_DVFS_NON_WFX\0cpu0,cpu1,cpu2,cpu3,cpu4,cpu5,cpu6,cpu7";
