	fragment@17 {
		target = <0xffffffff>;

		__overlay__ {

			display_therm {
				polling-delay = <0x00>;
				polling-delay-passive = <0x00>;
				thermal-sensors = <0xffffffff>;
				phandle = <0x70>;

				trips {

					display-therm-crit {
						temperature = <0x1d0d8>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0x71>;
					};
				};
			};
		};
	};

