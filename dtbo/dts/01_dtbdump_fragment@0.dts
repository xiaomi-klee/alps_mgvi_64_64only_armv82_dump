	fragment@19 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "mediatek,peak_power_budget";
			battery-circult-rdc = <0x0e>;
			battery0-path-rac-t0 = <0x2c>;
			battery0-path-rac-t1 = <0x2c>;
			battery0-path-rac-t2 = <0x2c>;
