<?xml version="1.0" encoding="UTF-8"?>
<!--
listeners is a statues set,if corresponding position is 1, that mean reg this listener.
    Now, contain the listener is:
    receiver,wifi_spot,bluetooth,bluetooth_pan,sarsensor1,sarsensor2,mcc,wifi,cable,hall,usb
    1: need to reg, 0 : don`t reg
    like for J18 device, listeners that need to reg is:  11111111110
    like for J3S device, listeners that need to reg is:  11111111100
    like for J1/J2 device, listeners that need to reg is 11111011000
dsiMap：
    1. F mean NA,the other state is corresponding listener value.
    2. wifi_spot,bluetooth,bluetooth_pan is one state: hotSpot.
    receiver,hotSpot,sarsensor1,sarsensor2,mcc,wifi,cable,hall,usb
    like for J18 device:
        DSI1: 10FF1F00
        DSI2: 10FF2F00,10FF3F00 == 10FF4F00
        DSI3: 0020FF00
        DSI4: 00102F00,00103F00 == 00104F00
        an so on
-->
<SarDsiConfig>
    <!-- use for sar uncouple framework -->
    <sarVersion>2</sarVersion>

    <!-- only use for CN -->
    <deviceSarConfig device_name="klee">
        <prop prop_name="ro.boot.hwc">CN</prop>
        <!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor1,sarsensor2,mcc,wifi,cable,hall,usb,lab -->
        <listeners>100000000001100011</listeners>
        <!-- receiver,sarsensor2,lab,game -->
        <dsimap value="F01F">0</dsimap>
        <dsimap value="100F">1</dsimap>
        <dsimap value="0000">2</dsimap>
        <dsimap value="11FF">3</dsimap>
        <dsimap value="01FF">4</dsimap>
        <dsimap value="0001">5</dsimap>
        <dsimap value="0002">6</dsimap>
    </deviceSarConfig>

    <!-- default configuration -->
    <deviceSarConfig device_name="klee">
        <prop prop_name="ro.boot.hwc">GL</prop>
        <!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor1,sarsensor2,mcc,wifi,cable,hall,usb,lab -->
        <listeners>1111010000010000001</listeners>
        <simMccList>001,002,432,630,629,450,404,405,406,429,413,470,716,712,732,730,748,744,736,714,704,370,722,740,706,708,710</simMccList>
        <!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor2,lab,gamme,mcc -->
        <dsimap value="10F0F">1</dsimap>
        <dsimap value="0010F">3</dsimap>
        <dsimap value="0000F">4</dsimap>
        <dsimap value="F1F0F">5</dsimap>
        <dsimap value="10F10">1</dsimap>
        <dsimap value="00110">3</dsimap>
        <dsimap value="00010">4</dsimap>
        <dsimap value="F1F10">5</dsimap>
        <dsimap value="FFF11">6</dsimap>
    </deviceSarConfig>

    <deviceSarConfig device_name="klee">
        <prop prop_name="ro.boot.hwc">IN</prop>
        <!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor1,sarsensor2,mcc,wifi,cable,hall,usb,lab -->
        <listeners>100000000000</listeners>
        <!-- receiver,hotspot,sarsensor1,sarsensor2 -->
        <dsimap value="1">1</dsimap>
        <dsimap value="0">2</dsimap>
    </deviceSarConfig>

    <!-- default configuration -->
    <deviceSarConfig device_name="klee">
        <prop prop_name="ro.boot.hwc">default</prop>
        <listeners>100000000001000011</listeners>
        <!-- receiver,sarsensor2,lab,game -->
        <dsimap value="10F">1</dsimap>
        <dsimap value="000">2</dsimap>
        <dsimap value="11F">3</dsimap>
        <dsimap value="01F">4</dsimap>
        <dsimap value="001">5</dsimap>
        <dsimap value="002">6</dsimap>
    </deviceSarConfig>
</SarDsiConfig>
