/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			simtray {
				compatible = "xiaomi,simtray-status";
				status-gpio = <0xffffffff 0x3a 0x00>;
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			regulator-always-on;
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			aw21024_led@30 {
				compatible = "awinic,aw21024_led";
				reg = <0x30>;
				reset-gpio = <0xffffffff 0x03 0x00>;
				apse_mode;
				clk_pwm = <0x01>;
				max_brightness = <0xff>;
				led_current = <0x3f>;
				led_wbr = <0xff>;
				led_wbg = <0xff>;
				led_wbb = <0xbf>;
				brightness = <0x7d>;
				status = "okay";
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			pwm_ch = <0x00>;
			pinctrl-names = "irtx_gpio_led_default\0irtx_gpio_led_set";
			pinctrl-0 = <0x01>;
			pinctrl-1 = <0x02>;
			status = "okay";
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			irtx_gpio_led_def@gpio119 {
				phandle = <0x01>;

				pins_cmd_dat {
					pinmux = <0x7700>;
					slew-rate = <0x01>;
					bias-disable;
					output-low;
					input-schmitt-enable = <0x00>;
				};
			};

			irtx_gpio_led_set@gpio119 {
				phandle = <0x02>;

				pins_cmd_dat {
					pinmux = <0x7701>;
					slew-rate = <0x01>;
					output-high;
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			xiaomi_fingerprint {
				compatible = "xiaomi,xiaomi-fp";
				xiaomi,vendor_names = "P10_n2_113_212_M_SPI2";
				spi-max-frequency = <0x7a1200>;
				netlink-event = <0x1d>;
				fp_3v3_vreg-supply = <0xffffffff>;
				power-type = <0x01>;
				pinctrl-names = "spiio_gpio_mode\0spiio_spi_mode\0reset_high\0reset_low\0eint_default\0eint_pulldown";
				pinctrl-0 = <0x03>;
				pinctrl-1 = <0x04>;
				pinctrl-2 = <0x05>;
				pinctrl-3 = <0x06>;
				pinctrl-4 = <0x07>;
				pinctrl-5 = <0x08>;
				xiaomi,gpio_irq = <0xffffffff 0x08 0x00>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x08 0x01 0x08 0x00>;
				status = "okay";
				phandle = <0x6e>;
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			regulator-min-microvolt = <0x325aa0>;
			regulator-max-microvolt = <0x325aa0>;
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			state_gpio_mode {
				phandle = <0x03>;

				pins_cmd_dat {
					pinmux = <0xb00>;
					drive-strength = <0x02>;
					input-enable;
					bias-disable;
				};

				pins_cmd2_dat {
					pinmux = <0xc00>;
					drive-strength = <0x02>;
					input-enable;
					bias-disable;
				};

				pins_cmd3_dat {
					pinmux = <0xd00>;
					drive-strength = <0x02>;
					input-enable;
					bias-disable;
				};

				pins_cmd4_dat {
					pinmux = <0xe00>;
					drive-strength = <0x02>;
					input-enable;
					bias-disable;
				};
			};

			state_spi_mode {
				phandle = <0x04>;

				pins_cmd_dat {
					pinmux = <0xb01>;
					drive-strength = <0x04>;
					input-enable;
					bias-disable;
				};

				pins_cmd2_dat {
					pinmux = <0xc01>;
					drive-strength = <0x02>;
					input-enable;
					bias-disable;
				};

				pins_cmd3_dat {
					pinmux = <0xd01>;
					drive-strength = <0x02>;
					input-enable;
					bias-disable;
				};

				pins_cmd4_dat {
					pinmux = <0xe01>;
					drive-strength = <0x02>;
					input-enable;
					bias-disable;
				};
			};

			state_reset_high {
				phandle = <0x05>;

				pins_cmd_dat {
					pinmux = <0x3c00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			state_reset_low {
				phandle = <0x06>;

				pins_cmd_dat {
					pinmux = <0x3c00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			state_eint_default {
				phandle = <0x07>;

				pins_cmd_dat {
					pinmux = <0x800>;
					slew-rate = <0x00>;
					input-enable;
					bias-disable;
					input-schmitt-enable;
				};
			};

			state_eint_pulldown {
				phandle = <0x08>;

				pins_cmd_dat {
					pinmux = <0x800>;
					slew-rate = <0x00>;
					input-enable;
					bias-pull-down;
					input-schmitt-enable;
				};
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {

			t1_gpio_vc_all {
				phandle = <0x09>;

				pins_cmd_dat {
					pinmux = <0xae00 0xad00>;
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {

			mi_t1_chip {
				compatible = "mdm,mi_t1_chip";
				gpio-count = <0x02>;
				first-gpio = <0xae>;
				mi-t1-gpio-1 = <0xffffffff 0xae 0x00>;
				mi-t1-gpio-2 = <0xffffffff 0xad 0x00>;
				pinctrl-names = "t1_gpio_vc_all";
				pinctrl-0 = <0x09>;
			};
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {
			bootargs_ext = "cpufreq.default_governor=conservative \t\t\t\t\t\t\tlog_buf_len=4M";
			bootargs_ext_fac = "maxcpus=6";
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "mediatek,disp-leds";

			backlight {
				label = "lcd-backlight";
				max-brightness = <0x3fff>;
				min-brightness = <0x01>;
				max-hw-brightness = <0x3fff>;
				led-mode = <0x04>;
				default-state = "cust_lk_backlight";
				lk_backlight = <0x4cd>;
			};
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {

			frsm_amp {
				compatible = "foursemi,frsm-amp";
				frsm,amp-ndev = <0x02>;
				frsm,has-tx-vi;
				frsm,class-enable;
				frsm,mntr-enable;
				frsm,mntr-period = <0x7d0>;
				frsm,mntr-avg-count = <0x02>;
				status = "ok";
			};
		};
	};

	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {

			thermal-message {
				board-sensor = "VIRTUAL-SENSOR";
				board-sensor-trip-enable = <0x01>;
				trip-point-high = <0xa028>;
				trip-point-low = <0x9c40>;
				phandle = <0x6f>;

				sysfs-nodes {

					foreground_app_name {
						mode-flag = <0x02>;
						data-flag = <0x00>;
					};

					therm_log_enable {
						mode-flag = <0x02>;
						data-flag = <0x01>;
						default = <0x00>;
					};

					boost_daily_track {
						mode-flag = <0x02>;
						data-flag = <0x00>;
					};

					boost_perapp_track {
						mode-flag = <0x02>;
						data-flag = <0x00>;
					};

					config_daily_track {
						mode-flag = <0x02>;
						data-flag = <0x00>;
					};
				};
			};
		};
	};

	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {

			vin3-open {
				channel = <0x15>;
				pures = <0x00>;
			};

			vin4-open {
				channel = <0x16>;
				pures = <0x00>;
			};

			vin5-open {
				channel = <0x17>;
				pures = <0x00>;
			};

			vin6-open {
				channel = <0x18>;
				pures = <0x00>;
			};
		};
	};

	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {

			vin1-open {
				channel = <0x13>;
				pures = <0x00>;
			};
		};
	};

