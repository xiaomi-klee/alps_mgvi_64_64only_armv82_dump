    "ms_MY": "POCO X8 Pro Ironman Edition Theme",
    "en_GB": "POCO X8 Pro Ironman Edition Theme",
    "zh_HK": "POCO X8 Pro Ironman 限定版 深度定制主題",
    "zh_TW": "POCO X8 Pro 鋼鐵人定製款 主題",
    "en_US": "POCO X8 Pro Ironman Edition Theme",
